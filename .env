# Copy to .env, fill in, and the app picks it up automatically
# (agents/llm_client.py loads .env on import). Never commit your real .env.

# --- Backend selector ------------------------------------------------------
# auto   = hosted only if LLM_BASE_URL + LLM_API_KEY are both set, else Ollama
# ollama = ALWAYS use local Ollama (ignore hosted config) - great for a fully
#          offline demo even when a key is also present in .env
# hosted = always use the hosted endpoint
LLM_BACKEND=hosted

# --- Local Ollama (works with zero config - this is the default) -----------
# Requires a local Ollama server (default http://localhost:11434). If the
# requested model isn't installed the client automatically picks the smallest
# one that is, so local just works.
# OLLAMA_URL=https://api.groq.com/openai/v1
# OLLAMA_MODEL=llama3.2:1b

# --- Hosted LLM (OPTIONAL - faster, ~2s per call; used when creds are set) --
# Any OpenAI-compatible /chat/completions endpoint works (Groq shown here).
# When LLM_BASE_URL + LLM_API_KEY are both set (and LLM_BACKEND is not
# "ollama"), the app uses the hosted endpoint INSTEAD of local Ollama.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=compound-beta
LLM_API_KEY=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
