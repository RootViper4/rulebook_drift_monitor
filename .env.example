# Copy to .env, fill in, and the app picks it up automatically
# (agents/llm_client.py loads .env on import). Never commit your real .env.

# --- Hosted LLM (RECOMMENDED for the demo - fast, ~2s per call) -----------
# Any OpenAI-compatible /chat/completions endpoint works (Groq shown here).
# When LLM_BASE_URL + LLM_API_KEY are both set, the app uses the hosted
# endpoint INSTEAD of local Ollama. This is the only way to get fast
# AI-generated threats (the local 1B model on a CPU-only machine is ~100x
# slower and frequently times out).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=groq/compound-mini
# LLM_API_KEY=your_groq_or_openrouter_key_here

# --- Local Ollama (offline fallback) --------------------------------------
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b